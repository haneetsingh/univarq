# Copy to .env.local and fill in. All keys are optional except where noted.

# --- Contact form email (Resend) ---
# Required for the contact form to send mail; without it POST /api/contact returns 500.
RESEND_API_KEY=
# Mailbox that sends and receives contact mail. Default: info@univarq.io
NEXT_PUBLIC_CONTACT_EMAIL=
# Display name on outgoing email. Default: Univarq
NEXT_PUBLIC_CONTACT_NAME=

# --- Cloudflare Turnstile (contact form spam check) ---
# All three must be set together. If NEXT_PUBLIC_TURNSTILE_SITE_KEY is unset the
# widget does not render and the server skips verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Comma-separated list of hostnames allowed to pass verification, e.g. univarq.io,www.univarq.io
TURNSTILE_HOSTNAMES=

# --- PostHog analytics ---
# Client-side token. In non-production the app throws on startup if this is missing.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# PostHog host for server-side events. Default: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=
